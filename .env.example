# All settings are optional; defaults work fully offline. No secrets are needed.
BP_SEED=0
BP_N_TRAIN=600          # parallel sentence pairs for training (x2 rows)
BP_N_TEST=300
BP_N_BOOT=1000          # bootstrap resamples
BP_OUT_DIR=artifacts
# Use multilingual Hugging Face sentence embeddings as features for the neural model.
# Needs `pip install sentence-transformers` and a one-time model download; falls back to TF-IDF on any failure.
BP_USE_EMBEDDINGS=0
BP_EMBED_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
# Optional CSV/TSV/JSONL with text,label,lang columns (see README).
BP_PUBLIC_DATA=
